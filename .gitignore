# Build output
/build/
/bin/
*.user
*.vcxproj.filters
*.suo
.vs/

# Keep vendored deps but ignore their build artifacts
third_party/**/*.obj
third_party/**/*.pdb

# Local editor state / config with credentials
imgui.ini
config/*.local.json
# machine-specific client-data path + prefs
config/settings.json
# DB connection profiles (may hold credentials)
config/connections.json

# Local project list (machine-specific paths / credentials)
config/projects.json
# Scratch DBC/model dumps from dev harness flags
/ADT.txt
/M2.txt
/WDL.txt
/WDT.txt
